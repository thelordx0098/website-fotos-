{{!< default}}

<div class="hero" id="home">
    <h1>KAMERA ABENTEUER</h1>
    <p>Tour Design & Fotografie von Katrin Tschachler Berger</p>
    <div class="cta-group">
        <a href="#touren" class="btn btn-primary">Fotoreisen entdecken</a>
        <a href="#portfolio" class="btn btn-secondary">Portfolio ansehen</a>
    </div>
</div>

<section id="about">
    <div class="about-content">
        <div>
            <h2 class="section-title" style="text-align: left; margin-bottom: 20px;">Katrin Tschachler Berger</h2>
            <p>Willkommen bei KameraAbenteuer! Ich bin leidenschaftliche Fotografin und organisiere maßgeschneiderte Fotoreisen in die atemberaubendsten Regionen Afrikas.</p>
            <br>
            <p>Mit jahrelanger Erfahrung im Feld führe ich kleine Gruppen zu den besten Zeiten an die besten Orte, um das perfekte Licht zu garantieren.</p>
        </div>
        <img id="img-katrin" src="{{asset "katrin.png"}}" class="about-img" alt="Katrin">
    </div>
</section>

<section id="portfolio" style="background-color: #171411; padding: 60px 20px;">
    <h2 class="section-title">Wildlife Portfolio</h2>
    <div class="gallery-grid">
        <div class="gallery-item"><img src="{{asset "geparden.png"}}" alt="Geparden"></div>
        <div class="gallery-item"><img src="{{asset "zebras.png"}}" alt="Zebras"></div>
        <div class="gallery-item"><img src="{{asset "flamingo.jpeg"}}" alt="Flamingo"></div>
        <div class="gallery-item"><img src="{{asset "loewen.png"}}" alt="Löwen"></div>
    </div>
</section>

<section id="touren" style="padding: 60px 20px; max-width: 1200px; margin: 0 auto;">
    <h2 class="section-title">Exklusive Fotoreisen</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px;">
        <div class="tour-card">
            <img id="img-tour1" src="{{asset "antilope.jpeg"}}" alt="Afrika Safari">
            <div class="tour-info">
                <h3>Südafrika & Botswana Wildlife Safari</h3>
                <p>Fokus auf Raubkatzen, Elefantenherden und die Kunst der Wildlife-Fotografie.</p>
                <br>
                <a href="#kontakt" class="btn btn-primary" style="display:block; text-align:center;">Reise anfragen</a>
            </div>
        </div>
        <div class="tour-card">
            <img id="img-tour2" src="{{asset "tiger.jpeg"}}" alt="Kenia Ranger">
            <div class="tour-info">
                <h3>Magisches Kenia – Zur Großen Wanderung</h3>
                <p>Erlebe die legendäre Masai Mara zur Zeit der großen Tierwanderungen.</p>
                <br>
                <a href="#kontakt" class="btn btn-primary" style="display:block; text-align:center;">Reise anfragen</a>
            </div>
        </div>
    </div>
</section>

<!-- DYNAMISCHER BLOG BEREICH -->
<section id="blog" style="background-color: #171411; padding: 60px 20px;">
    <h2 class="section-title">Abenteuer Blog</h2>
    
    {{#foreach posts limit="1"}}
    <div style="max-width: 900px; margin: 0 auto; background: #1e1a17; border-radius: 12px; overflow: hidden; display: flex; flex-wrap: wrap; border: 1px solid #3a322d;">
        <div style="flex: 1 1 400px; min-height: 250px;">
            <img src="{{img_url feature_image}}" alt="{{title}}" style="width: 100%; height: 100%; object-fit: cover; display: block;">
        </div>
        <div style="flex: 1 1 400px; padding: 40px; display: flex; flex-direction: column; justify-content: center;">
            <span style="color: #f3a953; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 10px;">{{date format="DD. MMMM YYYY"}}</span>
            <h3 style="font-family: 'Cinzel', serif; color: #fff; font-size: 1.8rem; margin-bottom: 15px; margin-top: 0;">{{title}}</h3>
            <p style="color: #a59285; line-height: 1.6; font-size: 0.95rem; margin: 0; margin-bottom: 20px;">{{excerpt words="30"}}...</p>
            <a href="{{url}}" style="color: #f3a953; font-weight: bold; text-decoration: none; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px;">Weiterlesen &rarr;</a>
        </div>
    </div>
    {{/foreach}}
</section>

<section id="kontakt" style="padding: 60px 20px; background-color: #120f0d;">
    <h2 class="section-title">Abenteuer starten</h2>
    <div style="max-width: 550px; margin: 0 auto; background: #1e1a17; padding: 40px; border-radius: 12px; border: 1px solid #3a322d; box-sizing: border-box;">
        <form action="https://formspree.io/f/xzdwlled" method="POST" id="contact-form">
            <div style="margin-bottom: 20px; text-align: left;">
                <label style="display: block; color: #fff; margin-bottom: 8px; font-weight: 600;">Dein Name</label>
                <input type="text" name="name" style="width: 100%; padding: 14px; background: #120f0d; border: 1px solid #4a3e36; color: #fff; border-radius: 6px;" required>
            </div>
            <div style="margin-bottom: 20px; text-align: left;">
                <label style="display: block; color: #fff; margin-bottom: 8px; font-weight: 600;">Deine E-Mail-Adresse</label>
                <input type="email" name="_replyto" style="width: 100%; padding: 14px; background: #120f0d; border: 1px solid #4a3e36; color: #fff; border-radius: 6px;" required>
            </div>
            <div style="margin-bottom: 25px; text-align: left;">
                <label style="display: block; color: #fff; margin-bottom: 8px; font-weight: 600;">Deine Nachricht</label>
                <textarea name="nachricht" rows="6" style="width: 100%; padding: 14px; background: #120f0d; border: 1px solid #4a3e36; color: #fff; border-radius: 6px;" required></textarea>
            </div>
            <button type="submit" id="submit-btn" style="width: 100%; padding: 16px; background: #f3a953; border: none; color: #171411; font-weight: bold; border-radius: 6px; cursor: pointer; text-transform: uppercase;">Nachricht senden</button>
            <div id="form-status" style="margin-top: 20px; font-weight: bold; text-align: center; color: #f3a953;"></div>
        </form>
    </div>
</section>
