<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title}}</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght=400;600&family=Montserrat:wght=300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Verknüpft deine CSS-Datei aus dem assets-Ordner -->
    <link rel="stylesheet" href="{{asset "css/style.css"}}">

    {{ghost_head}}
</head>
<body>

    <nav>
        <div class="logo-container">
            <img id="nav-logo" src="{{@site.logo}}" alt="{{@site.title}} Logo" class="logo-img">
            <span class="brand-name">{{@site.title}}</span>
        </div>
        <ul class="nav-links">
            <li><a href="#home">Start</a></li>
            <li><a href="#about">Über mich</a></li>
            <li><a href="#portfolio">Portfolio</a></li>
            <li><a href="#touren">Fotoreisen</a></li>
            <li><a href="#blog">Blog</a></li>
            <li><a href="#kontakt">Kontakt</a></li>
        </ul>
    </nav>

    <!-- Hier wird der Inhalt der index.hbs reingeladen -->
    {{{body}}}

    <footer>
        <p>&copy; {{date format="YYYY"}} {{@site.title}} | Katrin Tschachler Berger.</p>
    </footer>

    <script src="{{asset "js/app.js"}}"></script>
    {{ghost_foot}}
</body>
</html>
